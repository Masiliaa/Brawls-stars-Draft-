# Cache des réponses HTTP de refresh.py
.cache/

# Outils de test
node_modules/
package-lock.json
__pycache__/

# Sortie de travail du traducteur (le cache, lui, est versionné)
data/a_traduire.json

# NOTE : assets/ n'est volontairement PAS ignoré.
# Les images téléchargées par « refresh.py --assets » doivent être
# committées, sinon elles ne partent jamais sur GitHub et le site en ligne
# continue d'afficher les initiales à la place des portraits.

# Fichier cree par le Finder de macOS, sans interet pour le projet
.DS_Store

# La planche de maquettes assemblee : 2,2 Mo de code d'editeur engendre a
# partir des fichiers de design/, qui eux sont versionnes. La reconstruire
# est une commande ; la committer alourdirait le depot pour rien.
design/*.html
!design/*.dc.html
